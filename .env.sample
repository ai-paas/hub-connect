HF_API_TOKEN=<your_huggingface_api_token>

# ==========================================
# Kaggle 마켓 설정 (선택사항)
# ==========================================
# https://www.kaggle.com/settings 에서 발급받은 API 토큰(권장, Python 3.11+)
# 미설정시 /api/v1/*?market=kaggle 호출은 503 응답
KAGGLE_API_TOKEN=
# 레거시 자격증명(선택): API 토큰이 없을 때만 사용
KAGGLE_USERNAME=
KAGGLE_KEY=
# 요청 타임아웃 (초)
KAGGLE_TIMEOUT=30
KAGGLE_DOWNLOAD_TIMEOUT=300

# JWT 인증 설정
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# 관리자 계정 설정
# ==========================================
ADMIN_USERNAME=admin

# 개발 환경 설정 (평문 비밀번호 사용)
# ADMIN_PASSWORD_HASH가 비어있거나 설정되지 않으면 평문 비밀번호 사용
ADMIN_PASSWORD=admin123

# 프로덕션 환경 설정 (해시된 비밀번호 사용)
# ADMIN_PASSWORD_HASH가 설정되면 평문 비밀번호는 무시됨
# 해시 생성: python scripts/generate_password_hash.py your_password
ADMIN_PASSWORD_HASH=

# 사용 시나리오:
# 1. 개발용: ADMIN_PASSWORD_HASH=""로 두고 ADMIN_PASSWORD만 설정
# 2. 프로덕션용: ADMIN_PASSWORD_HASH에 해시값 설정하고 ADMIN_PASSWORD 제거 권장

# Storage 설정 (aws/ceph)
STORAGE_TYPE=aws

# AWS S3 설정
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-northeast-2

# Ceph S3 설정
CEPH_ACCESS_KEY_ID=your_ceph_access_key_id
CEPH_SECRET_ACCESS_KEY=your_ceph_secret_access_key
CEPH_ENDPOINT_URL=http://url:port

# ==========================================
# Docker 환경 설정
# ==========================================

# 애플리케이션 포트 (Docker에서 노출될 포트)
APP_PORT=8001

# 로그 레벨 설정
LOG_LEVEL=INFO

# 캐시 새로고침 간격 (초) - 태그 데이터 백그라운드 갱신
CACHE_REFRESH_INTERVAL=3600  # 1시간 (1800=30분, 10800=3시간)

# 개발/프로덕션 모드
ENVIRONMENT=development

# Docker 컨테이너 내 데이터 디렉토리
DATA_DIR=/app/data
LOG_DIR=/app/logs

# Docker 네트워크 설정 (host 모드 사용시 localhost 접근 가능)
# Bridge 모드 사용시 컨테이너 간 통신을 위한 설정
DOCKER_NETWORK_MODE=host

# 헬스체크 엔드포인트
HEALTH_CHECK_PATH=/health

# ==========================================
# Redis 설정 (선택사항 - Tus 업로드 상태 관리)
# ==========================================

# Redis 서버 접속 정보 (설정하지 않으면 Redis/Tus 기능 비활성화됨)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# Redis 활성화시 Tus 대용량 파일 업로드 지원
# Redis 미설정시 일반 파일 업로드만 지원
# Docker 환경에서는 자동으로 redis 컨테이너로 연결됩니다

# ==========================================
# Tus 프로토콜 설정
# ==========================================

# Tus 업로드용 S3 버킷
TUS_UPLOAD_BUCKET=tus-uploads

# Tus 업로드 제한 설정
TUS_MAX_FILE_SIZE=10737418240    # 10GB (바이트)
TUS_CHUNK_SIZE=10485760          # 10MB (바이트)
TUS_BUFFER_SIZE=104857600        # 100MB (바이트)

# Tus 업로드 세션 만료 시간 (초)
TUS_EXPIRATION_SECONDS=86400     # 24시간
TUS_BUFFER_EXPIRATION=3600       # 1시간

# 대용량 파일 업로드 최적화
# - AUTO: 파일 크기에 따라 자동 계산
# - MANUAL: 수동으로 파트 크기 지정 (바이트)
TUS_PART_SIZE_MODE=AUTO
TUS_MANUAL_PART_SIZE=104857600    # 100MB (MANUAL 모드시)

# 업로드 성능 모니터링
TUS_ENABLE_METRICS=true
TUS_LOG_LEVEL=INFO               # DEBUG, INFO, WARNING, ERROR

# ==========================================
# 데이터셋 다운로드 설정
# ==========================================

# 커스텀 다운로드 디렉토리 (설정하지 않으면 HuggingFace 기본 캐시 사용)
# 동적 경로 지원: ~ (홈 디렉토리), %USERPROFILE% (Windows), $HOME (Linux/Mac)
# DATASET_DOWNLOAD_DIR=~/Downloads
# DATASET_DOWNLOAD_DIR=%USERPROFILE%\Downloads  # Windows
# DATASET_DOWNLOAD_DIR=$HOME/Downloads           # Linux/Mac
# DATASET_DOWNLOAD_DIR=C:\Users\your_username\Downloads
